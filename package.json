{
  "name": "kalpixa-web-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/stamp-release.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:function": "node scripts/verify-seo-function.mjs",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.mjs && node scripts/verify-form-contract.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "test:browser": "playwright test",
    "release:check": "npm run lint && npm test && npm run build && npm run verify:export"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "next": "16.3.3",
    "parse5": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  }
}
